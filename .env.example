# Google Gemini API Key (Required for multimodal AI and Gemini Live Real-Time Voice)
GEMINI_API_KEY=your_gemini_api_key_here

# Voice Mode ('gemini' for real-time live voice, or 'mock' for local offline testing)
VOICE_MODE=gemini

# Server Configuration
HOST=127.0.0.1
PORT=8000

# ==========================================
# SMTP Email Configuration (Real Email Verification)
# ==========================================
# Provide your SMTP details below to deliver real 6-digit OTP verification emails.
# For Gmail:
#   1. Set SMTP_HOST=smtp.gmail.com
#   2. Set SMTP_PORT=587
#   3. Set SMTP_USERNAME=your_gmail_address@gmail.com
#   4. Set SMTP_PASSWORD=your_16_character_google_app_password
#   5. Set EMAIL_FROM="seeSpeak AI <your_gmail_address@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=seeSpeak AI <noreply@seespeak.ai>
